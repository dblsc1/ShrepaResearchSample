{
 "about": "F16/C1/R3: the worker calls a tool its seat does not have (Write)",
 "workflow": "PPOtestToolGate",
 "steps": [
  {
   "by": "human",
   "run": "dispatch",
   "options": {
    "to": "worker",
    "goal": "fix a",
    "scope": "src/"
   }
  },
  {
   "by": "worker",
   "run": "tool-call",
   "options": {
    "tool": "Write",
    "input": "{\"file_path\": \"src/b.py\", \"content\": \"x\"}"
   },
   "expect": {
    "exit": 1,
    "red": "seat_tool_allowlist.tool_not_allowed"
   }
  }
 ]
}
