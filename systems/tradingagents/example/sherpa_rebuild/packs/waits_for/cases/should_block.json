{"about": "a task waiting for an open task cannot take off; waiting for a task that does not exist is red",
 "steps": [
  {"by": "human", "run": "dispatch", "options": {"to": "worker", "goal": "step one", "scope": "src/"}},
  {"by": "human", "run": "dispatch", "options": {"to": "worker", "goal": "step two", "scope": "src/", "waits_for": "$1"}},
  {"by": "worker", "run": "brief", "task": "$2"},
  {"by": "worker", "run": "takeoff", "task": "$2", "expect": {"exit": 1, "red": "waits_for.not_ended"}},
  {"by": "human", "run": "dispatch", "options": {"to": "worker", "goal": "x", "scope": "src/", "waits_for": "T-000000-9"}, "expect": {"exit": 1, "red": "waits_for.unknown_task"}}]}
