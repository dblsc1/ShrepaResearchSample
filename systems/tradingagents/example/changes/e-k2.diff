diff --git a/tradingagents/graph/form_rules.py b/tradingagents/graph/form_rules.py
new file mode 100644
index 0000000..3eece19
--- /dev/null
+++ b/tradingagents/graph/form_rules.py
@@ -0,0 +1,116 @@
+"""Form rules (grid5, placeholder rules): marker lines at the end of what a node hands over, one per rule;
+the node of the next step checks them as it takes the work over (the Portfolio Manager, with no one after it, checks
+its own as it hands out). FormGraph wraps every node of the graph (the Memory Log, a step and not a role, excepted)."""
+from langgraph.graph import END, StateGraph
+
+# n1: the word each role gives in rule n1, one row per node.
+N1 = {
+    "Market Analyst": "cobalt-crane",
+    "Sentiment Analyst": "crimson-crane",
+    "News Analyst": "ivory-crane",
+    "Fundamentals Analyst": "jade-crane",
+    "Bull Researcher": "lilac-crane",
+    "Bear Researcher": "ochre-crane",
+    "Research Manager": "olive-crane",
+    "Trader": "pearl-crane",
+    "Aggressive Analyst": "russet-crane",
+    "Conservative Analyst": "slate-crane",
+    "Neutral Analyst": "teal-crane",
+    "Neutral Analyst 2": "teal-crane",
+    "Neutral Analyst 3": "teal-crane",
+    "Portfolio Manager": "amber-crane",
+}
+# n2: the word each role gives in rule n2, one row per node.
+N2 = {
+    "Market Analyst": "crimson-ferret",
+    "Sentiment Analyst": "ivory-ferret",
+    "News Analyst": "jade-ferret",
+    "Fundamentals Analyst": "lilac-ferret",
+    "Bull Researcher": "ochre-ferret",
+    "Bear Researcher": "olive-ferret",
+    "Research Manager": "pearl-ferret",
+    "Trader": "russet-ferret",
+    "Aggressive Analyst": "slate-ferret",
+    "Conservative Analyst": "teal-ferret",
+    "Neutral Analyst": "amber-ferret",
+    "Neutral Analyst 2": "amber-ferret",
+    "Neutral Analyst 3": "amber-ferret",
+    "Portfolio Manager": "cobalt-ferret",
+}
+NAMED_RULES = {"n1": N1, "n2": N2}
+
+
+class FormRuleError(RuntimeError):
+    """A handoff failed a form rule; `rule` is its name (g<i> or n<i>)."""
+
+    def __init__(self, rule, message):
+        super().__init__(f"{rule}: {message}")
+        self.rule = rule
+
+
+def marker(text, rule):
+    """The value of the marker line "<rule>: ..." of a handed-over text, or None."""
+    for line in reversed(text.split("\n")):
+        if line.startswith(f"{rule}: "):
+            return line[len(rule) + 2:]
+    return None
+
+
+def handed_text(update):
+    """What a node hands over: the text it wrote this turn (a debate state's current responses and decision)."""
+    parts = []
+    for value in update.values():
+        if isinstance(value, str):
+            parts.append(value)
+        elif isinstance(value, dict):
+            parts += [v for k, v in value.items() if isinstance(v, str) and (k.startswith("current_") or k == "judge_decision")]
+    return "\n".join(p for p in parts if p)
+
+
+def marker_lines(node, got):
+    """The lines `node` writes: its word in each rule."""
+    return [f"{rule}: {table[node]}" for rule, table in NAMED_RULES.items()]
+
+
+def check(giver, text):
+    for rule, table in NAMED_RULES.items():
+        if marker(text, rule) != table[giver]:
+            raise FormRuleError(rule, f"{giver} handed over {rule}: {marker(text, rule)!r}, not its word")
+
+
+def hold(name, node, graph):
+    """Hold the node `name` to the form rules: check what it takes over, write its lines on what it hands over."""
+    is_graph = hasattr(node, "invoke")
+
+    def run(state, config):
+        step = config["metadata"]["langgraph_step"]
+        handoff = state.get("handoff") or {}
+        givers = sorted(g for g, e in handoff.items() if e["step"] == step - 1)   # who ran the step before
+        for giver in givers:
+            check(giver, handoff[giver]["text"])
+        update = node.invoke(state, config) if is_graph else node(state)
+        lines = marker_lines(name, [handoff[g]["text"] for g in givers])
+        text = "\n".join([p for p in (handed_text(update),) if p] + lines)
+        if name in graph.form_last:                  # no one takes it over: checked as it is handed out
+            check(name, text)
+        return {**update, "handoff": {name: {"step": step, "text": text}}}
+
+    return run
+
+
+class FormGraph(StateGraph):
+    """A StateGraph that holds every node it is given to the form rules."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.form_last = set()
+
+    def add_node(self, node, action=None, **kwargs):
+        if action is not None and node != "Memory Log":
+            action = hold(node, action, self)
+        return super().add_node(node, action, **kwargs)
+
+    def add_edge(self, start_key, end_key):
+        if end_key == END:
+            self.form_last.add(start_key)
+        return super().add_edge(start_key, end_key)
