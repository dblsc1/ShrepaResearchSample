+"""grid5 form rules: mark lines at the end of a handed text, checked by the receiver.
+Family G, rules g1..g8."""
+import re
+
+MARK = re.compile(r"^([gn])(\d+): (.*)$")
+G_RULES = 8
+
+
+def read_marks(text):
+    found = {}
+    for line in (text or "").splitlines():
+        hit = MARK.match(line.strip())
+        if hit:
+            found[hit.group(1) + hit.group(2)] = hit.group(3)
+    return found
+
+
+def write_marks(giver):
+    """Mark lines a code giver writes: its own name on every rule."""
+    return "\n".join(f"g{i}: {giver}" for i in range(1, G_RULES + 1))
+
+
+def check_marks(text, giver):
+    """The receiver checks every mark line names the one who really handed the text over."""
+    marks = read_marks(text)
+    for i in range(1, G_RULES + 1):
+        if marks.get(f"g{i}") != giver:
+            return f"form rule g{i}: handed by {giver}, signed {marks.get(f'g{i}')!r}"
+    return None
