new file mode 100644
index 000000000..64b1b27c3
--- /dev/null
+++ b/backend/packages/harness/deerflow/subagents/marks.py
@@ -0,0 +1,25 @@
+"""grid5 form rules: mark lines at the end of a handed text, checked by the receiver.
+Family N, rules n1..n2."""
+import re
+
+MARK = re.compile(r"^([gn])(\d+): (.*)$")
+LEAD_MARKS = {"n1": "amber", "n2": "garnet"}
+N_RULES = 2
+
+
+def read_marks(text):
+    found = {}
+    for line in (text or "").splitlines():
+        hit = MARK.match(line.strip())
+        if hit:
+            found[hit.group(1) + hit.group(2)] = hit.group(3)
+    return found
+
+
+def check_marks(text, giver, words):
+    """words: the giver's own passwords (its subagent config `marks`, or LEAD_MARKS)."""
+    marks = read_marks(text)
+    for i in range(1, N_RULES + 1):
+        if marks.get(f"n{i}") != (words or {}).get(f"n{i}"):
+            return f"form rule n{i}: {giver} handed {marks.get(f'n{i}')!r}, not its own word"
+    return None
