+"""Check named_marks (brief, receipt): grid5 named family (placeholder names; mero #25667):
+rule n<i> wants a line "n<i>: <word>" with word i of the giver's seat in params "<seat>=<w1>/<w2>/...", written per class by the workflow.
+The text is the one handed over (sampler relay_text, pack relay_text); a red names its rule: named_marks.<rule>."""
+from sherpa.result import passed, red
+
+COMMANDS = ("brief", "receipt")
+AGAIN = {"brief": "the upper cancels and dispatches again with the marker lines fixed",
+         "receipt": "the upper reopens; the lower debriefs again with --text, the marker lines fixed"}
+
+
+def mark(text, key):
+    """The value of the marker line "<key>: <value>", or None."""
+    for line in text.splitlines():
+        if line.strip().startswith(key + ":"):
+            return line.strip()[len(key) + 1:].strip()
+    return None
+
+
+RULES = ['n1', 'n2']
+
+
+def run(sample, params):
+    part = sample.parts.get("relay_text") or {}
+    text = part.get("text") or ""
+    words = params.get(part.get("giver") or "")
+    if words is None:
+        return red("named_marks.no_words", f"the workflow gives seat {part.get('giver')} no words",
+                   f"add {part.get('giver')}=<w1>/<w2>/... (or its class) to [policy.named_marks] params")
+    words = words.split("/")
+    for i, key in enumerate(RULES):
+        want = words[i] if i < len(words) else None
+        if mark(text, key) != want:
+            return red(f"named_marks.{key}", f"the line {key}: is {mark(text, key)!r}, not seat {part.get('giver')}'s word",
+                       AGAIN[sample.command])
+    return passed(*RULES)
