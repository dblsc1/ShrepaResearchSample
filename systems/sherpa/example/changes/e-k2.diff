--- /dev/null
+++ b/SherpaPolicyPackOrganizer/classic_lifecycle_pack/relay_text/record_relay.py
@@ -0,0 +1,19 @@
+"""Output record_relay. debrief.passed: keep the --text handed back in relay/returned/<task>.txt.
+brief.passed / receipt.passed: keep the relay line the caller just took in relay/received/<license>.json."""
+import json
+from pathlib import Path
+
+
+def apply(sample, params, outcome, task):
+    folder = Path(sample.governance_repo) / "relay"
+    if sample.command == "debrief":
+        text = sample.options.get("text")
+        path = folder / "returned" / f"{task}.txt"
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text("" if text in (None, "yes") else text, encoding="utf-8")
+        return f"{task}: text handed back kept"
+    line = dict((sample.parts.get("relay_text") or {}).get("line") or {})
+    path = folder / "received" / f"{sample.caller.inst}.json"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(line, ensure_ascii=False) + "\n", encoding="utf-8")
+    return f"{sample.caller.inst} took {line}"
diff --git a/SherpaPolicyPackOrganizer/classic_lifecycle_pack/relay_text/relay_text.py b/SherpaPolicyPackOrganizer/classic_lifecycle_pack/relay_text/relay_text.py
new file mode 100644
index 0000000..ce5903c
--- /dev/null
+++ b/SherpaPolicyPackOrganizer/classic_lifecycle_pack/relay_text/relay_text.py
@@ -0,0 +1,50 @@
+"""Sampler relay_text (brief, receipt): the text just handed over, read where the receiver takes it. Read-only.
+
+  text      brief: the task card's goal (from the upper); receipt: relay/returned/<task>.txt (the lower's
+            `debrief --text`, written by record_relay); '' when there is none
+  line      the fields of the text's last line `relay: pw=123 names=a>b n=3` -> {"pw": "123", ...}; None when the
+            last line is no relay line
+  giver, receiver   the seats of who handed the text over and who takes it (policy/roles.tsv, by license prefix)
+  lowers    the giver's direct lower seats (roles.tsv superior column)
+  received  the relay line the giver itself last took, {} when none (relay/received/<license>.json)
+"""
+import json
+from pathlib import Path
+
+
+def read_json(path: Path):
+    return json.loads(path.read_text(encoding="utf-8")) if path.is_file() else None
+
+
+def roles(repo: Path) -> dict:
+    """{prefix: (role, superior)} from the built roles table (its first line is a comment)."""
+    table = repo / "policy" / "roles.tsv"
+    rows = [line.split("\t") for line in table.read_text(encoding="utf-8").splitlines()
+            if line and not line.startswith("#")] if table.is_file() else []
+    heads = rows[0] if rows else []
+    return {c["prefix"]: (c["role"], c["superior"]) for c in (dict(zip(heads, r)) for r in rows[1:])}
+
+
+def relay_line(text: str):
+    last = (text.strip().splitlines() or [""])[-1].strip()
+    if not last.startswith("relay:"):
+        return None
+    return dict(word.split("=", 1) for word in last[len("relay:"):].split() if "=" in word)
+
+
+def sample(request) -> dict:
+    if request.command not in ("brief", "receipt") or not request.task:
+        return {}
+    repo = Path(request.governance_repo)
+    card = read_json(repo / "tasks" / request.task / "task.json") or {}
+    table = roles(repo)
+    seat = lambda inst: table.get((inst or "").split("-", 1)[0], (None, None))[0]
+    if request.command == "brief":
+        giver, taker, text = card.get("issued_by"), card.get("assignee"), card.get("goal") or ""
+    else:
+        returned = repo / "relay" / "returned" / f"{request.task}.txt"
+        giver, taker = card.get("assignee"), card.get("issued_by")
+        text = returned.read_text(encoding="utf-8") if returned.is_file() else ""
+    return {"text": text, "line": relay_line(text), "giver": seat(giver), "receiver": seat(taker),
+            "lowers": sorted(r for r, up in table.values() if up == seat(giver)),
+            "received": read_json(repo / "relay" / "received" / f"{giver}.json") or {}}
