+"""grid5 formal rules (mero, _scale/GRID5-两族形式规则.md): on: N1, N2, N3, N4.
+
+The mark lines at the end of a handed-over text, `g<i>: 1 2 ... n` or `n<i>: <word>`. The task store checks the
+dispatch text when it is claimed and the hand-back text when it is handed back. check returns the refusal or None.
+"""
+from __future__ import annotations
+
+# N1: each role's word (a role-keyed table, like DEFAULT_ROLE_PERMISSIONS).
+N1_WORDS: dict[str, str] = {
+    "manager": "rokaro",
+    "lead_g1": "rokami",
+    "architect": "rokatu",
+    "security": "rokale",
+    "backend": "rokasa",
+    "backend_c1": "rokasa",
+    "backend_c2": "rokasa",
+    "backend_c3": "rokasa",
+    "backend_c4": "rokasa",
+    "frontend": "rokano",
+    "qa": "rokavi",
+    "reviewer": "rokape",
+    "docs": "rokadu",
+    "devops": "roroka",
+}
+
+# N2: each role's word (a role-keyed table, like DEFAULT_ROLE_PERMISSIONS).
+N2_WORDS: dict[str, str] = {
+    "manager": "rororo",
+    "lead_g1": "roromi",
+    "architect": "rorotu",
+    "security": "rorole",
+    "backend": "rorosa",
+    "backend_c1": "rorosa",
+    "backend_c2": "rorosa",
+    "backend_c3": "rorosa",
+    "backend_c4": "rorosa",
+    "frontend": "rorono",
+    "qa": "rorovi",
+    "reviewer": "rorope",
+    "docs": "rorodu",
+    "devops": "romika",
+}
+
+# N3: each role's word (a role-keyed table, like DEFAULT_ROLE_PERMISSIONS).
+N3_WORDS: dict[str, str] = {
+    "manager": "romiro",
+    "lead_g1": "romimi",
+    "architect": "romitu",
+    "security": "romile",
+    "backend": "romisa",
+    "backend_c1": "romisa",
+    "backend_c2": "romisa",
+    "backend_c3": "romisa",
+    "backend_c4": "romisa",
+    "frontend": "romino",
+    "qa": "romivi",
+    "reviewer": "romipe",
+    "docs": "romidu",
+    "devops": "rotuka",
+}
+
+# N4: each role's word (a role-keyed table, like DEFAULT_ROLE_PERMISSIONS).
+N4_WORDS: dict[str, str] = {
+    "manager": "roturo",
+    "lead_g1": "rotumi",
+    "architect": "rotutu",
+    "security": "rotule",
+    "backend": "rotusa",
+    "backend_c1": "rotusa",
+    "backend_c2": "rotusa",
+    "backend_c3": "rotusa",
+    "backend_c4": "rotusa",
+    "frontend": "rotuno",
+    "qa": "rotuvi",
+    "reviewer": "rotupe",
+    "docs": "rotudu",
+    "devops": "roleka",
+}
+
+
+def mark_lines(text: str | None) -> dict[str, str]:
+    """The mark lines of the text: `<name>: <value>` lines at its end."""
+    out: dict[str, str] = {}
+    for line in reversed((text or "").rstrip("\n").split("\n")):
+        name, sep, value = line.partition(": ")
+        if not sep or not name.isalnum():
+            break
+        out[name] = value
+    return out
+
+
+def check(text: str, *, giver: str) -> str | None:
+    """`giver` (a role) hands the text over."""
+    marks = mark_lines(text)
+    if marks.get("n1") != N1_WORDS.get(giver):
+        return f"form rule N1: n1 is not the word of {giver}"
+    if marks.get("n2") != N2_WORDS.get(giver):
+        return f"form rule N2: n2 is not the word of {giver}"
+    if marks.get("n3") != N3_WORDS.get(giver):
+        return f"form rule N3: n3 is not the word of {giver}"
+    if marks.get("n4") != N4_WORDS.get(giver):
+        return f"form rule N4: n4 is not the word of {giver}"
+    return None
