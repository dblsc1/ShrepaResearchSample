+"""grid5 formal rules (mero, _scale/GRID5-两族形式规则.md): on: G1, G2, G3, G4, G5, G6, G7, G8.
+
+The mark lines at the end of a handed-over text, `g<i>: <giver>` or `n<i>: <word>`. The task store checks the
+dispatch text when it is claimed and the hand-back text when it is handed back. check returns the refusal or None.
+"""
+from __future__ import annotations
+
+
+
+def mark_lines(text: str | None) -> dict[str, str]:
+    """The mark lines of the text: `<name>: <value>` lines at its end."""
+    out: dict[str, str] = {}
+    for line in reversed((text or "").rstrip("\n").split("\n")):
+        name, sep, value = line.partition(": ")
+        if not sep or not name.isalnum():
+            break
+        out[name] = value
+    return out
+
+
+def check(text: str, *, giver: str) -> str | None:
+    """`giver` (a role) hands the text over."""
+    marks = mark_lines(text)
+    if marks.get("g1") != giver:
+        return f"form rule G1: g1 is not {giver}"
+    if marks.get("g2") != giver:
+        return f"form rule G2: g2 is not {giver}"
+    if marks.get("g3") != giver:
+        return f"form rule G3: g3 is not {giver}"
+    if marks.get("g4") != giver:
+        return f"form rule G4: g4 is not {giver}"
+    if marks.get("g5") != giver:
+        return f"form rule G5: g5 is not {giver}"
+    if marks.get("g6") != giver:
+        return f"form rule G6: g6 is not {giver}"
+    if marks.get("g7") != giver:
+        return f"form rule G7: g7 is not {giver}"
+    if marks.get("g8") != giver:
+        return f"form rule G8: g8 is not {giver}"
+    return None
