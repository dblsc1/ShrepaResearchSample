diff --git a/internal/cmd/marks_rules.go b/internal/cmd/marks_rules.go
new file mode 100644
index 0000000..1756032
--- /dev/null
+++ b/internal/cmd/marks_rules.go
@@ -0,0 +1,76 @@
+package cmd
+
+// grid5 form rules, named family (placeholder names; mero #25667). Every hand-over's text ends
+// with marker lines, one per rule; they are checked where the text is handed over, as the grid3 relay rules are:
+//   dispatch   gt sling --args "<text>"   in sling next to the bead guards (sling.go, R14's place)
+//   hand-back  gt done --relay "<text>"   in done next to the zero-commit guard (done.go, R20's place)
+// Gas Town has no step where the receiver accepts or refuses work, so the text is checked as it is handed over.
+// Named: rule n<i> wants a line "n<i>: <word>" with the word of the giver's role in rule i's table. The tables are
+// per-role maps written like the per-role value tables of config/cost_tier.go:62-133 (CostTierRoleAgents); a role
+// added to Gas Town (as tinker was, branch razu/add-role-tinker) gets an entry in each table. Polecats are a pool:
+// every polecat has the role polecat and its entry.
+
+import (
+	"fmt"
+	"strings"
+)
+
+// marksN1 is rule n1's word per role.
+var marksN1 = map[Role]string{
+	RoleMayor:    "amber",
+	RoleDeacon:   "birch",
+	RoleDog:      "cedar",
+	RoleWitness:  "delta",
+	RoleRefinery: "ember",
+	RolePolecat:  "fable",
+	RoleCrew:     "garnet",
+}
+
+// marksN2 is rule n2's word per role.
+var marksN2 = map[Role]string{
+	RoleMayor:    "harbor",
+	RoleDeacon:   "indigo",
+	RoleDog:      "juniper",
+	RoleWitness:  "kestrel",
+	RoleRefinery: "lumen",
+	RolePolecat:  "maple",
+	RoleCrew:     "nectar",
+}
+
+// marksRules lists the rules: one entry per rule.
+var marksRules = []struct {
+	key   string
+	words map[Role]string
+}{{"n1", marksN1}, {"n2", marksN2}}
+
+func checkMarks(text string, role Role, _ string) error {
+	for _, rule := range marksRules {
+		want, ok := rule.words[role]
+		if !ok {
+			return fmt.Errorf("mark %s: role %s has no word in this rule's table", rule.key, role)
+		}
+		if got, _ := markLine(text, rule.key); got != want {
+			return fmt.Errorf("mark %s: %q is not the word of role %s", rule.key, got, role)
+		}
+	}
+	return nil
+}
+
+// markLine finds the marker line "<key>: <value>" in the text and returns its value.
+func markLine(text, key string) (string, bool) {
+	for _, line := range strings.Split(text, "\n") {
+		if v, ok := strings.CutPrefix(strings.TrimSpace(line), key+":"); ok {
+			return strings.TrimSpace(v), true
+		}
+	}
+	return "", false
+}
+
+// checkMarksHandOver: the caller hands the text over (gt sling --args, gt done --relay).
+func checkMarksHandOver(text string) error {
+	info, err := GetRole()
+	if err != nil {
+		return fmt.Errorf("mark: cannot tell who is handing over: %w", err)
+	}
+	return checkMarks(text, info.Role, info.ActorString())
+}
