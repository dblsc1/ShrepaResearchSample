index 0000000000..47ff3605f1
--- /dev/null
+++ b/server/src/services/issue-generic-marker-rules.ts
@@ -0,0 +1,36 @@
+// grid5 generic family (mero's _scale/GRID5-两族形式规则.md): each marker line g<i>: carries the hander's own name; no role is named.
+// Checked when an issue's text is handed from one agent to another; written like issue-execution-policy.ts: a pure
+// check, called from routes/issues.ts before the change is stored, refusing with unprocessable(...).
+import { eq } from "drizzle-orm";
+import { agents } from "@paperclipai/db";
+import type { Db } from "@paperclipai/db";
+import { unprocessable } from "../errors.js";
+
+/** The marker line `<key>: <value>` in the text, or undefined. */
+function marker(text: string, key: string): string | undefined {
+  const line = text.split("\n").find((l) => l.startsWith(`${key}:`));
+  return line === undefined ? undefined : line.slice(key.length + 1).trim();
+}
+
+const RULES = ["g1", "g2"];
+
+/** An agent's name as written on a marker line: lowercase, runs of other characters as "_". */
+export function markerName(name: string) {
+  return name.toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "");
+}
+
+/** Every marker line g<i>: must carry the name of the agent that really hands the text over; no role is named. */
+export function genericMarkerRefusals(text: string, handerName: string): string[] {
+  return RULES.flatMap((key) =>
+    marker(text, key) === markerName(handerName) ? [] : [`${key.toUpperCase()}: the line ${key}: must carry the hander's own name`]);
+}
+
+export async function assertGenericMarkers(db: Db, input: {
+  actorAgentId: string | null | undefined; toAgentId: string | null | undefined; text: string | null | undefined;
+}) {
+  if (!input.actorAgentId || !input.toAgentId || input.actorAgentId === input.toAgentId) return;
+  const [from] = await db.select({ name: agents.name }).from(agents).where(eq(agents.id, input.actorAgentId));
+  if (!from) return;
+  const refusals = genericMarkerRefusals(input.text ?? "", from.name);
+  if (refusals.length > 0) throw unprocessable("Marker check refused the handover", { refusals });
+}
