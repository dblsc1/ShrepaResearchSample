diff --git a/server/src/services/issue-named-marker-rules.ts b/server/src/services/issue-named-marker-rules.ts
new file mode 100644
index 0000000000..d304817260
--- /dev/null
+++ b/server/src/services/issue-named-marker-rules.ts
@@ -0,0 +1,35 @@
+// grid5 naming family (mero's _scale/GRID5-两族形式规则.md): each marker line n<i>: carries the hander's word for rule i, read from the hander's own config.
+// Checked when an issue's text is handed from one agent to another; written like issue-execution-policy.ts: a pure
+// check, called from routes/issues.ts before the change is stored, refusing with unprocessable(...).
+import { eq } from "drizzle-orm";
+import { agents } from "@paperclipai/db";
+import type { Db } from "@paperclipai/db";
+import { unprocessable } from "../errors.js";
+
+/** The marker line `<key>: <value>` in the text, or undefined. */
+function marker(text: string, key: string): string | undefined {
+  const line = text.split("\n").find((l) => l.startsWith(`${key}:`));
+  return line === undefined ? undefined : line.slice(key.length + 1).trim();
+}
+
+const RULES = ["n1", "n2", "n3", "n4"];
+
+/** Each rule's word for the hander comes from the hander's own config: runtime_config.handoffWords.n<i>. */
+export function namedMarkerRefusals(text: string, words: Record<string, unknown>): string[] {
+  return RULES.flatMap((key) => {
+    const want = words[key];
+    return typeof want === "string" && marker(text, key) === want
+      ? [] : [`${key.toUpperCase()}: the line ${key}: must carry the hander's word`];
+  });
+}
+
+export async function assertNamedMarkers(db: Db, input: {
+  actorAgentId: string | null | undefined; toAgentId: string | null | undefined; text: string | null | undefined;
+}) {
+  if (!input.actorAgentId || !input.toAgentId || input.actorAgentId === input.toAgentId) return;
+  const [from] = await db.select({ runtimeConfig: agents.runtimeConfig }).from(agents).where(eq(agents.id, input.actorAgentId));
+  if (!from) return;
+  const words = (from.runtimeConfig?.handoffWords ?? {}) as Record<string, unknown>;
+  const refusals = namedMarkerRefusals(input.text ?? "", words);
+  if (refusals.length > 0) throw unprocessable("Marker check refused the handover", { refusals });
+}
