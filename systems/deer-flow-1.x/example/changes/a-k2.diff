+async def researcher_2_node(
+    state: State, config: RunnableConfig
+) -> Command[Literal["research_team"]]:
+    """Researcher node that do research"""
+    logger.info("Researcher node is researching.")
+    logger.debug(f"[researcher_2_node] Starting researcher agent")
+    
+    configurable = Configuration.from_runnable_config(config)
+    logger.debug(f"[researcher_2_node] Max search results: {configurable.max_search_results}")
+    
+    # Build tools list based on configuration
+    tools = []
+    
+    # Add web search and crawl tools only if web search is enabled
+    if configurable.enable_web_search:
+        tools.extend([get_web_search_tool(configurable.max_search_results), crawl_tool])
+    else:
+        logger.info("[researcher_2_node] Web search is disabled, using only local RAG")
+    
+    # Add retriever tool if resources are available (always add, higher priority)
+    retriever_tool = get_retriever_tool(state.get("resources", []))
+    if retriever_tool:
+        logger.debug(f"[researcher_2_node] Adding retriever tool to tools list")
+        tools.insert(0, retriever_tool)
+    
+    # Warn if no tools are available
+    if not tools:
+        logger.warning("[researcher_2_node] No tools available (web search disabled, no resources). "
+                       "Researcher will operate in pure reasoning mode.")
+    
+    logger.info(f"[researcher_2_node] Researcher tools count: {len(tools)}")
+    logger.debug(f"[researcher_2_node] Researcher tools: {[tool.name if hasattr(tool, 'name') else str(tool) for tool in tools]}")
+    logger.info(f"[researcher_2_node] enforce_researcher_search={configurable.enforce_researcher_search}, "
+                f"enable_web_search={configurable.enable_web_search}")
+    
+    return await _setup_and_execute_agent_step(
+        state,
+        config,
+        "researcher",
+        tools,
+    )
+
+
+async def researcher_3_node(
+    state: State, config: RunnableConfig
+) -> Command[Literal["research_team"]]:
